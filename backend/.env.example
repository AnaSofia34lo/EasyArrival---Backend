SUPABASE_URL= Tu Url de tu base de datos de supabase. La puedes encontrar en la sección de configuración de tu proyecto en supabase. En el apartado de API, en la sección de "Project URL"
SUPABASE_SERVICE_ROLE_KEY= Tu clave de servicio de supabase. La puedes encontrar en la sección de configuración de tu proyecto en supabase. En el apartado de API, en la sección de "Service Key"
SUPABASE_ANON_KEY= Tu clave anónima de supabase. La puedes encontrar en la sección de configuración de tu proyecto en supabase. En el apartado de API, en la sección de "Anon Key"
PORT=3001

# AI_PROVIDER: gemini | deepseek | heuristic
AI_PROVIDER=heuristic # El proveedor de IA que deseas utilizar. Puedes elegir entre "gemini", "deepseek" o "heuristic". Si eliges "gemini" o "deepseek", asegúrate de proporcionar las claves de API correspondientes en las variables GEMINI_API_KEY o DEEPSEEK_API_KEY.

# Gemini
# GEMINI_API_KEY= Tu clave de API de Gemini. La puedes encontrar en la sección de configuración de tu proyecto en Gemini. En el apartado de API, en la sección de "API Key"
GEMINI_MODEL=gemini-2.0-flash # El modelo que deseas utilizar de Gemini. Puedes encontrar los modelos disponibles en la documentación de Gemini.

# DeepSeek
# DEEPSEEK_API_KEY= Tu clave de API de DeepSeek. La puedes encontrar en la sección de configuración de tu proyecto en DeepSeek. En el apartado de API, en la sección de "API Key"
DEEPSEEK_MODEL=deepseek-chat # El modelo que deseas utilizar de DeepSeek. Puedes encontrar los modelos disponibles en la documentación de DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com # La URL base de la API de DeepSeek. No es necesario cambiarla a menos que DeepSeek indique lo contrario en su documentación.
